[
  {
      "caption": "Preferences: FileBrowser Settings",
      "command": "edit_settings",
      "args": {
          "base_file": "${packages}/FileBrowser/dired.sublime-settings",
          "default": "// Settings in here override those in \"FileBrowser/dired.sublime-settings\",\n\n{\n\t$0\n}\n"
      }
  },
  {
      "caption": "Preferences: FileBrowser Key Bindings",
      "command": "edit_settings",
      "args": {
          "base_file": "${packages}/FileBrowser/Default (${platform}).sublime-keymap"
      }
  },

  {
    "caption": "\"Browse Mode\" is now FileBrowser",
    // "caption": "Browse Mode: Commands are now under FileBrowser",
    "command": "dired_noop"
  },
  {
    "caption": "FileBrowser: Open Directory…",
    "command": "dired"
  },
  {
    "caption": "FileBrowser: Open Current File’s Directory or Project",
    "command": "dired",
    "args": { "immediate": true }
  },
  {
    "caption": "FileBrowser: Open Jump List",
    "command": "dired_jump_list"
  },
  {
    "caption": "FileBrowser: Open Jump List Quick Panel",
    "command": "dired_jump",
    "args": { "new_window": "auto" }
  },
  {
    "caption": "FileBrowser: Open Left Sidebar",
    "command": "dired",
    "args": {
      "immediate": true,
      "other_group": "left",
      "single_pane": true,
      "project": true
    }
  },
  {
    "caption": "FileBrowser: Open Right Sidebar",
    "command": "dired",
    "args": {
      "immediate": true,
      "other_group": "right",
      "single_pane": true,
      "project": true
    }
  }
]
